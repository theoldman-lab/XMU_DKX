*.docx
*.pdf
*.md

# ==================== 临时文件 ====================
tmp/
temp/
trash/
*.tmp

# ==================== work 目录特殊规则 ====================
# 只保留 .py 源代码文件，忽略其他所有文件
work/results/**/*
!work/results/**/*.py
work/figures/**/*
!work/figures/**/*.py
work/trash/**/*
work/.venv/**/*
work/codes.zip

